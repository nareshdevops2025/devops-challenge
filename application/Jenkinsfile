pipeline {
  agent any
  tools {
        maven 'maven-3'
        jdk 'JDK'
    }
  environment {
    IMAGE_NAME = "devops-challenge"
    REGISTRY = "localhost:5000"
    TF_IN_AUTOMATION = "true"
  }

  stages {

    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/nareshdevops2025/devops-challenge.git'
      }
    }

      stage('Build Image') {
            steps {
                dir('application') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

  stage('Terraform Init') {
    steps {
          dir('terraform') {
        script {
            if (isUnix()) {
               sh 'terraform init'
            } else {
                bat 'terraform init'
            }
        }
          }
    }
}


    
      stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }
