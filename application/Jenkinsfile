pipeline {
  agent any

    tools {
        maven 'Maven'
        jdk 'JDK'
    }

  stages {
    stage('Build') {
      steps {
        echo "before build"
        cmd /c echo Jenkins CMD OK
        cmd /c java -version
        cmd /c mvn -version
        cmd /c mvn clean package
        echo "after build"
      }
    }
    stage('SonarQube') {
      steps {
        echo "before sonar"
         'mvn sonar:sonar'
        echo "after sonar"
      }
    }
    stage('Docker Build') {
      steps {
        'docker build -t hello:latest -f docker/Dockerfile .'
      }
    }
    stage('Security Scan') {
      steps {
        'trivy image hello:latest'
      }
    }
    stage('Deploy') {
      steps {
        'helm upgrade --install hello helm/hello-app'
      }
    }
  }
}